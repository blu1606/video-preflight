{
  "name": "video-intelligence-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db": "cd ../db && json-server db.json --port 3101",
    "db:build": "uv run --directory .. python db/build_db.py",
    "py": "uv run --directory .. uvicorn api:app --port 8100",
    "lab": "concurrently -k -n DB,PY,WEB -c cyan,yellow,magenta \"pnpm db\" \"pnpm py\" \"pnpm dev\"",
    "lab:api-web": "concurrently -k -n PY,WEB -c yellow,magenta \"pnpm py\" \"pnpm dev\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "json-server": "0.17.4",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
