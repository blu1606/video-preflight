{$SITE_ADDRESS} {
    encode zstd gzip

    request_body {
        max_size 250MB
    }

    handle_path /api/* {
        reverse_proxy db:3101
    }
    handle /py/* {
        reverse_proxy api:8100 {
            flush_interval -1
        }
    }
    handle /media/* {
        reverse_proxy api:8100
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
