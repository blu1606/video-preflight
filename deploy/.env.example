# Copy to /opt/video-preflight/shared/app.env on the server (chmod 600).
# Use a domain pointing to the Terraform public_ip for automatic HTTPS.
SITE_ADDRESS=preflight.example.com
DEMO_USER=demo
# Generate: docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Single quotes preserve the dollar signs when Docker Compose reads this file.
DEMO_PASSWORD_HASH='$2a$14$REPLACE_WITH_A_REAL_CADDY_HASH'

# Leave empty for cache/rules-only demos. Setting a key enables billable API paths,
# including the policy reviewer which is currently enabled by default in the app.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna

# Optional: OpenAI-compatible endpoint, only if you explicitly choose one.
# OPENAI_BASE_URL=https://your-provider.example/v1
